{
  "name": "devdoc",
  "private": true,
  "version": "1.3.0",
  "description": "A local developer workspace for Mac.",
  "author": "Timothy Koelsch",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeriousGooseDevelopment/V0.20.git"
  },
  "homepage": "https://github.com/SeriousGooseDevelopment/V0.20",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mac": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.timothykoelsch.devdoc",
    "productName": "DevDoc",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/devdoc.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
